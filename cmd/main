#!/bin/bash

### Open-Games 生命周期脚本：start / stop / status
### 启动内置静态服务，托管「游戏选择面板 + 单文件网页游戏」

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

APPNAME="Open-Games"
CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DEST="${TRIM_APPDEST:-$(cd "${CMD_DIR}/.." && pwd)}"
PKG_VAR="${TRIM_PKGVAR:-/tmp/${APPNAME}}"
WWW_ROOT="${APP_DEST}/www"
SERVER_PY="${APP_DEST}/server/server.py"
PORT="${TRIM_SERVICE_PORT:-8468}"
HOST="0.0.0.0"
LOG_FILE="${PKG_VAR}/info.log"
PID_FILE="${PKG_VAR}/app.pid"

mkdir -p "${PKG_VAR}" 2>/dev/null

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "${LOG_FILE}" 2>/dev/null
}

fail() {
    # fnOS 会把 TRIM_TEMP_LOGFILE 的内容展示在应用中心
    log_msg "ERROR: $*"
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "$*" >> "${TRIM_TEMP_LOGFILE}"
    fi
    return 1
}

find_python() {
    # 逐个探测：要求解释器真的能跑（避开 Windows 应用商店的占位程序），且版本 >= 3.7
    for candidate in python3 python /usr/bin/python3 /usr/local/bin/python3; do
        command -v "${candidate}" >/dev/null 2>&1 || continue
        if "${candidate}" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)' >/dev/null 2>&1; then
            command -v "${candidate}"
            return 0
        fi
    done
    return 1
}

check_process() {
    kill -0 "$1" 2>/dev/null
}

port_open() {
    (exec 3<>"/dev/tcp/127.0.0.1/${PORT}") 2>/dev/null && exec 3>&- && return 0
    return 1
}

pid_of() {
    if [ -r "${PID_FILE}" ]; then
        head -n 1 "${PID_FILE}" | tr -d '[:space:]'
    fi
}

status() {
    local pid
    pid="$(pid_of)"
    if [ -n "${pid}" ] && check_process "${pid}"; then
        return 0
    fi
    [ -n "${pid}" ] && rm -f "${PID_FILE}"
    return 1
}

start_process() {
    if status; then
        log_msg "already running (pid=$(pid_of))"
        return 0
    fi

    local py
    py="$(find_python)" || { fail "未找到 python3，无法启动 Open-Games 服务"; return 1; }
    [ -f "${SERVER_PY}" ] || { fail "服务脚本缺失：${SERVER_PY}"; return 1; }
    [ -d "${WWW_ROOT}" ] || { fail "静态资源目录缺失：${WWW_ROOT}"; return 1; }

    if port_open; then
        fail "端口 ${PORT} 已被占用，请在应用设置中修改端口后重试"
        return 1
    fi

    log_msg "starting ${py} ${SERVER_PY} --host ${HOST} --port ${PORT} --root ${WWW_ROOT}"
    nohup "${py}" -u "${SERVER_PY}" --host "${HOST}" --port "${PORT}" --root "${WWW_ROOT}" \
        >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"

    local count=0
    while [ ${count} -lt 20 ]; do
        if port_open; then
            log_msg "started (pid=${pid}, port=${PORT})"
            return 0
        fi
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            fail "服务启动失败，请查看日志：${LOG_FILE}"
            return 1
        fi
        sleep 1
        count=$((count + 1))
    done

    log_msg "waiting for port ${PORT} timed out, keep process ${pid}"
    return 0
}

stop_process() {
    local pid
    pid="$(pid_of)"

    if [ -z "${pid}" ]; then
        log_msg "no pid file, nothing to stop"
        return 0
    fi

    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        log_msg "process ${pid} not running, pid file removed"
        return 0
    fi

    log_msg "stopping pid=${pid}"
    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

    local count=0
    while check_process "${pid}" && [ ${count} -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "${pid}"; then
        log_msg "force killing pid=${pid}"
        kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
        sleep 1
    fi

    rm -f "${PID_FILE}"
    log_msg "stopped"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status && port_open; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "usage: $0 {start|stop|status}"
    exit 1
    ;;
esac
